<Window xaml:Class="GlyphForge.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:xaml="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GlyphForge.Presentation"
        Title="GlyphForge"
        Height="450"
        Width="800"
        Background="#151516">
    <Window.Resources>

        <SolidColorBrush xaml:Key="AccentColor"
                         Color="#7851a9"/>

        <Style xaml:Key="SectionTitle"
               TargetType="{xaml:Type TextBlock}">

            <Setter Property="FontSize"
                    Value="24"/>

            <Setter Property="FontFamily"
                    Value="Cascadia Code"/>

            <Setter Property="Foreground"
                    Value="{StaticResource AccentColor}"/>

            <Setter Property="FontWeight"
                    Value="DemiBold"/>

        </Style>

        <Style xaml:Key="SubTitle"
               TargetType="{xaml:Type TextBlock}"
               BasedOn="{StaticResource SectionTitle}">

            <Setter Property="FontSize"
                    Value="16"/>

            <Setter Property="FontWeight"
                    Value="Normal"/>

            <Setter Property="Foreground"
                    Value="#ECECED"/>

            <Setter Property="Margin"
                    Value="0, 20, 0, 5"/>

        </Style>

        <Style xaml:Key="ContentText"
               TargetType="{xaml:Type TextBlock}"
               BasedOn="{StaticResource SectionTitle}">

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Foreground"
                    Value="#ADADAC"/>

            <Setter Property="FontWeight"
                    Value="Light"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="Margin"
                    Value="10, 0, 0, 0"/>

        </Style>
        
        <Style TargetType="{xaml:Type TextBox}">

            <Setter Property="FontSize"
                    Value="16"/>

            <Setter Property="Background"
                    Value="#161617"/>

            <Setter Property="Foreground"
                    Value="#ABABAC"/>

            <Setter Property="Padding"
                    Value="5"/>

            <Setter Property="BorderBrush"
                    Value="#29292A"/>

            <Setter Property="BorderThickness"
                    Value="2"/>

            <Setter Property="FontFamily"
                    Value="Cascadia Code"/>

        </Style>

        <Style TargetType="Button">

            <Setter Property="FontFamily"
                    Value="Cascadia Code"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Background"
                    Value="#252526"/>

            <Setter Property="Foreground"
                    Value="{StaticResource AccentColor}"/>

            <Setter Property="BorderBrush"
                    Value="#29292A"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="10, 5"/>

        </Style>
        
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Input"
                       Style="{StaticResource SectionTitle}"
                       Grid.ColumnSpan="2"/>

            <TextBlock Text="Naming template"
                       Style="{StaticResource SubTitle}"
                       Grid.Row="1"
                       Grid.ColumnSpan="2"/>

            <TextBox Grid.Row="2"
                     Grid.ColumnSpan="2"/>

            <TextBlock Text="Select folder with .svg icons"
                       Style="{StaticResource SubTitle}"
                       Grid.Row="3"
                       Grid.ColumnSpan="2"/>

            <Button Content="Select"
                    Grid.Row="4"
                    Click="SelectFolderButton_Click"/>

            <TextBlock xaml:Name="_folderName_TextBlock"
                       Text="No directory selected"
                       Grid.Row="4"
                       Grid.Column="1"
                       Style="{StaticResource ContentText}"/>

            <Button Content="Create dictionary"
                    Grid.Row="5"
                    Grid.ColumnSpan="2"
                    VerticalAlignment="Bottom"
                    Click="CreateDictionaryButton_Click"/>

        </Grid>

        <Border CornerRadius="1"
                Width="2"
                Background="#1A1A1C"
                Grid.Column="1"
                Margin="10"/>

        <Grid Grid.Column="2"
              Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Output"
                       Style="{StaticResource SectionTitle}"
                       Grid.ColumnSpan="2"/>

            <TextBlock Text="Finded icons"
                       Style="{StaticResource SubTitle}"
                       Grid.Row="1"
                       Grid.ColumnSpan="2"/>

            <WrapPanel Grid.Row="2"
                       Grid.ColumnSpan="2"/>

            <TextBlock Text="Debug info"
                       Style="{StaticResource SubTitle}"
                       Grid.Row="3"
                       Grid.ColumnSpan="2"/>

            <TextBlock Text="No debug information"
                       Style="{StaticResource ContentText}"
                       Grid.Row="4"
                       Margin="0"
                       Grid.ColumnSpan="2"/>

            <TextBlock Text="Actions"
                       Style="{StaticResource SubTitle}"
                       Grid.Row="5"
                       Grid.ColumnSpan="2"/>

            <Button Content="Export in file"
                    Grid.Row="6"
                    Margin="0, 0, 5, 0" Click="ExportButton_Click"/>

            <Button Content="Copy to clipboard"
                    Grid.Row="6"
                    Grid.Column="1"
                    Margin="5, 0, 0 ,0" Click="CopyButton_Click"/>

        </Grid>
        
    </Grid>

</Window>